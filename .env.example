# PostgreSQL connection string (pooled). Used by the API at runtime.
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://sorolens:sorolens@localhost:5432/sorolens?sslmode=disable

# PostgreSQL direct (non-pooled) connection string.
# Used for migrations; bypasses PgBouncer transaction-mode pooling.
DIRECT_DATABASE_URL=postgres://sorolens:sorolens@localhost:5432/sorolens?sslmode=disable

# Redis connection string. Used by the indexer for advisory locks and the API for caching.
REDIS_URL=redis://localhost:6379

# Soroban RPC endpoint. Use the SDF testnet endpoint for development.
# For mainnet, use a commercial provider (Ankr, QuickNode, etc.).
# Set one or more of the network-specific variables below; the indexer will use
# the matching endpoint for each contract's configured network.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org:443
SOROBAN_RPC_URL_MAINNET=https://soroban-mainnet.stellar.org:443
SOROBAN_RPC_URL_FUTURENET=https://soroban-futurenet.stellar.org:443

# Stellar network identifier. Controls which network passphrase the app uses.
# Valid values: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet

# HTTP port for the API server.
PORT=8080

# Log level. Valid values: debug | info | warn | error
LOG_LEVEL=info

# How often the indexer polls for new ledger events (Go duration string).
# At 5-6 seconds per ledger, 5m gives roughly 50-60 ledgers per run.
INDEXER_POLL_INTERVAL=5m

# Number of past ledgers to include in a backfill window.
# 120960 ledgers at ~5s/ledger is approximately 7 days.
INDEXER_LEDGER_WINDOW=120960

# Maximum wall-clock time a single indexer run may take before forced exit.
# Set just under the cron interval (5m) so runs do not overlap.
INDEXER_MAX_DURATION=270s

# Sorolens API endpoint. Used by the CLI to communicate with the backend services.
# Change this if connecting to a remote deployment instead of the local server.
SOROLENS_API_URL=http://localhost:8080

# ---- watchdog ---------------------------------------------------------------

# Deployed sorolens-watchdog Soroban contract id (56-char, starts with C).
# After running contracts/watchdog/scripts/deploy-testnet.sh, take the id it
# prints and set it here so the indexer knows which contract's events to
# treat as watchdog telemetry rather than generic contract events.
WATCHDOG_CONTRACT_ID=CACXRL67WL5KRD6HKWGYADHEUF6RQOCODUN26UQE7MGFZEMIR7PAX6R7

# Public URL of the API for the browser dashboard. Set to your deployed API
# origin for staging/prod; leave as the localhost default for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- cold storage (issue #146) ----------------------------------------------

# S3-compatible bucket that holds archived events as Parquet files.
# Leaving this empty disables the cold-storage tier: the nightly archive job
# refuses to run and the API never falls back to object storage.
# Local development and integration tests use the MinIO service in
# docker-compose.yml:
#   docker compose exec minio mc mb --ignore-existing local/sorolens-archive
COLD_STORAGE_BUCKET=sorolens-archive

# Events older than this many days are exported to Parquet and deleted from
# Postgres by the nightly archive job.
COLD_STORAGE_THRESHOLD_DAYS=90

# Signing region. S3-compatible services generally accept us-east-1.
COLD_STORAGE_REGION=us-east-1

# Custom endpoint for MinIO / Backblaze B2 / other S3-compatible services.
# Leave empty to use the standard AWS endpoint for the region.
COLD_STORAGE_ENDPOINT=http://localhost:9000

# Explicit credentials. Leave both empty to use the default AWS credential
# chain (environment, shared config, IAM role).
COLD_STORAGE_ACCESS_KEY_ID=sorolens
COLD_STORAGE_SECRET_ACCESS_KEY=sorolens123